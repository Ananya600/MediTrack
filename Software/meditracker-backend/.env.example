PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# The one account that controls this system. Used only by `npm run seed`
# to create the account the first time — after that, change the password
# through the account, not this file (there's no re-seed-to-update path).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
